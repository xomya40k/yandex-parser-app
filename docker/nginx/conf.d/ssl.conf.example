# Activate AFTER issuing a Let's Encrypt certificate:
#   1. docker compose run --rm certbot certonly --webroot -w /var/www/certbot \
#        -d YOUR_DOMAIN --email YOUR_EMAIL --agree-tos --no-eff-email
#   2. cp docker/nginx/conf.d/ssl.conf.example docker/nginx/conf.d/ssl.conf
#   3. Replace YOUR_DOMAIN below with the real hostname
#   4. Comment out (or replace) the plain HTTP server in app.conf so port 80
#      only redirects / serves ACME (see the redirect server block below)
#   5. docker compose exec nginx nginx -s reload
#
# Suggested HTTP block replacement for app.conf after TLS is live:
#
# server {
#     listen 80;
#     listen [::]:80;
#     server_name YOUR_DOMAIN;
#
#     location ^~ /.well-known/acme-challenge/ {
#         root /var/www/certbot;
#         default_type "text/plain";
#         try_files $uri =404;
#     }
#
#     location / {
#         return 301 https://$host$request_uri;
#     }
# }

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name YOUR_DOMAIN;

    ssl_certificate     /etc/letsencrypt/live/YOUR_DOMAIN/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/YOUR_DOMAIN/privkey.pem;
    ssl_session_timeout 1d;
    ssl_session_cache shared:SSL:10m;
    ssl_protocols TLSv1.2 TLSv1.3;

    root /var/www/html/public;
    index index.php;

    client_max_body_size 20M;

    location / {
        try_files $uri $uri/ /index.php?$query_string;
    }

    location ~ \.php$ {
        try_files $uri =404;
        include fastcgi_params;
        fastcgi_pass app:9000;
        fastcgi_param SCRIPT_FILENAME $realpath_root$fastcgi_script_name;
        fastcgi_param DOCUMENT_ROOT $realpath_root;
        fastcgi_param HTTP_X_FORWARDED_PROTO https;
        fastcgi_param HTTPS on;
        fastcgi_read_timeout 120s;
        fastcgi_buffers 16 16k;
        fastcgi_buffer_size 32k;
    }

    location ~* \.(?:css|js|jpg|jpeg|gif|png|svg|ico|webp|woff2?)$ {
        expires 7d;
        access_log off;
        try_files $uri =404;
    }

    location ~ /\.(?!well-known).* {
        deny all;
    }
}
